# ==========================================
# Starlet VIP Directory - Git Ignore Rules
# ==========================================

# 1. Dependencies & Package Managers
node_modules/
*/node_modules/
jspm_packages/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 2. Build Outputs & Compilations
dist/
dist-ssr/
build/
starlet-app/dist/
starlet-app/dist-ssr/
*.local

# 3. Environment & Local Configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 4. Logs, Runtime PIDs & Temporary Files
logs/
*.log
scratch/
*.pid
*.seed
*.pid.lock
*.tmp
*.temp

# 5. Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 6. Editor & IDE Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# 7. Media & Wallpapers
# avatars, poses, and custom wallpapers in wallpapers/ or downloads/ are preserved.
# If any 4K video exceeds GitHub's 100MB limit, track via Git LFS:
# git lfs track "*.mp4"

